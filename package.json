{
  "name": "tail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram signal calls become one-tap Strike bracket orders.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "keygen": "tsx scripts/keygen.ts",
    "spikes": "tsx scripts/spike-a.ts && tsx scripts/spike-b.ts",
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "check:push": "bash scripts/prepush-check.sh"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "ethers": "^6.17.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "grammy": "^1.46.0"
  }
}
