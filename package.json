{
  "name": "tail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram signal calls become one-tap Strike bracket orders.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "keygen": "tsx scripts/keygen.ts",
    "spikes": "tsx scripts/spike-a.ts && tsx scripts/spike-b.ts",
    "start": "tsx src/main.ts",
    "dev": "tsx watch src/main.ts",
    "check:push": "bash scripts/prepush-check.sh",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts"
  },
  "devDependencies": {
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "ethers": "^6.17.0",
    "motion": "^14.5.0",
    "playwright-core": "^1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fastify/static": "^10.1.7",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.7",
    "grammy": "^1.46.0",
    "tsx": "^4.23.15"
  }
}
